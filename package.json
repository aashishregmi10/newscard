{
  "name": "newscard",
  "version": "0.1.0",
  "private": true,
  "description": "Bilingual short-form news application for the Nepali market",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/cms-api",
    "apps/worker"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose -f infra/docker-compose.dev.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.dev.yml down",
    "db:init": "tsx scripts/init-db.ts",
    "db:seed": "tsx scripts/gen-images.ts && tsx scripts/seed.ts",
    "dev:api": "tsx watch apps/api/src/server.ts",
    "dev:cms": "tsx watch apps/cms-api/src/server.ts",
    "dev:cms-web": "npm --prefix apps/cms-web run dev",
    "mobile": "node scripts/mobile.mjs",
    "mobile:doctor": "node scripts/mobile.mjs --doctor",
    "check:forbidden": "tsx scripts/check-forbidden-deps.ts",
    "media:gen": "tsx scripts/gen-images.ts",
    "media:fetch": "tsx scripts/fetch-demo-images.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "sharp": "^0.35.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
