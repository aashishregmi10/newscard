# Copy to .env and fill in. NEVER commit .env.
# Every variable here is parsed and validated at boot (apps/api/src/config).
# A missing or malformed value fails startup rather than surfacing later as a runtime error.

NODE_ENV=development

# --- database ---
# Transactions (publish flow) require a replica set, even for a single node.
# infra/docker-compose.dev.yml initiates rs0 automatically.
#
# NOTE THE PORT: 27018, not the MongoDB default. A locally-installed MongoDB
# service often already holds 27017; if it does, the container's port never
# binds and you connect to that standalone without noticing, then hit a
# confusing transaction error much later. The project database is deliberately
# on its own port.
MONGO_URI=mongodb://localhost:27018/newscard?replicaSet=rs0&directConnection=true

# --- public API ---
API_PORT=3000
API_BASE_URL=http://localhost:3000

# --- cursor signing (Ch. 6.5.3) ---
# 32+ random bytes, base64. Generate: openssl rand -base64 32
CURSOR_SECRET=replace-me-with-32-random-bytes

# --- CMS ---
CMS_PORT=3001
CMS_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-me-with-32-random-bytes

# --- object store (images) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=newscard-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
CDN_BASE_URL=/media

# --- notifications (Ch. 10.9) ---
# Defaults to false everywhere. Set true ONLY in production.
NOTIFICATIONS_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- observability ---
SENTRY_DSN=
LOG_LEVEL=debug
