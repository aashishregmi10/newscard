# Production settings. Copy to .env.production at the repository root on the
# server (it is ignored by git), fill every value, and keep it readable only by
# the account that runs Docker:  chmod 600 .env.production
#
# The servers refuse to start in production when a required value is missing.

# --- the address ---------------------------------------------------------
# The domain Caddy serves (and gets the HTTPS certificate for), without https://
SAAR_DOMAIN=saar.example.com
# The same domain, as the editorial API's allowed origin
CMS_ORIGIN=https://saar.example.com

# --- the database (a PRODUCTION Atlas database, not the development one) --
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/saar_prod

# --- secrets: generate each with  openssl rand -base64 48  -----------------
CURSOR_SECRET=
# Turns Google accounts into reader ids. NEVER change it once readers exist:
# every reader would become new, and every vote castable again.
READER_ID_SECRET=

# --- Google ------------------------------------------------------------------
# The Web client ID readers sign in with (Google Cloud → Credentials)
GOOGLE_WEB_CLIENT_ID=
# YouTube Data API key, restricted to this server's IP (Shorts collection)
YOUTUBE_API_KEY=
# Gemini key for drafting summaries (free tier: aistudio.google.com)
GEMINI_API_KEY=

# --- behaviour ---------------------------------------------------------------
# Pushes really go to phones only when this is true
NOTIFICATIONS_ENABLED=true
# Proxies in front of the servers: Caddy alone is 1; a CDN in front makes 2
TRUST_PROXY_HOPS=1
LOG_LEVEL=info
CDN_BASE_URL=/media
