# Copy to .env and fill in. NEVER commit .env.
# Every variable here is parsed and validated at boot (apps/api/src/config).
# A missing or malformed value fails startup rather than surfacing later as a runtime error.

NODE_ENV=development

# --- database ---
# Any MongoDB works, including the standalone one a local install gives you.
# Docker is NOT required: publishing uses a transaction where the deployment
# offers one and a compare-and-swap where it does not, so a replica set is a
# nice-to-have rather than a prerequisite.
#
# If you DO run the bundled stack (npm run db:up) it publishes on 27018, to
# avoid colliding with a system MongoDB already holding 27017.
MONGO_URI=mongodb://localhost:27017/newscard
# Integration tests write and DELETE collections. Point them at a separate
# database or a test run will wipe the data you were developing against —
# the symptom is an empty feed straight after `npm test`, which looks like a
# code bug and is not one.
MONGO_TEST_URI=mongodb://localhost:27017/newscard_test


# --- public API ---
API_PORT=3000
API_BASE_URL=http://localhost:3000

# --- cursor signing (Ch. 6.5.3) ---
# 32+ random bytes, base64. Generate: openssl rand -base64 32
CURSOR_SECRET=replace-me-with-32-random-bytes

# --- CMS ---
CMS_PORT=3001
CMS_ORIGIN=http://localhost:5173
SESSION_SECRET=replace-me-with-32-random-bytes

# --- object store (images) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=newscard-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
CDN_BASE_URL=/media

# --- notifications (Ch. 10.9) ---
# Defaults to false everywhere. Set true ONLY in production.
NOTIFICATIONS_ENABLED=false
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# --- observability ---
SENTRY_DSN=
LOG_LEVEL=debug
